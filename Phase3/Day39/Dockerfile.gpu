# v1.1 階段一:GPU/FP16版本。跟CPU版(Dockerfile)分開開一個檔案維護,
# 因為base image差異太大(CUDA runtime vs slim),放同一個Dockerfile用build arg切換
# 反而容易搞混兩條路徑各自要COPY哪些模型檔案,分開檔案比較清楚。
#
# CUDA/cuDNN 走 pip 安裝(onnxruntime-gpu官方支援的方式),不用cudnn專用的base image,
# 用 cuda:12.4.1-runtime 這種比較輕量的runtime tag即可。
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Ubuntu 22.04 內建 python3 就是3.10,直接用它,不額外裝python3.11
# (避免apt裝的python3-pip目標跟另一個python版本對不上)。
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-gpu.txt .
RUN pip3 install --no-cache-dir -r requirements-gpu.txt

# onnxruntime-gpu 用 pip 裝的 nvidia-cudnn-cu12 找 libcudnn.so.9,
# 這個套件把.so裝在python site-packages底下,不在系統ldconfig路徑,要手動加進去。
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/nvidia/cudnn/lib:/usr/local/lib/python3.10/dist-packages/nvidia/cublas/lib:${LD_LIBRARY_PATH}

COPY app/ ./app/
# v1.1階段二(CPU vs GPU比較)兩條路徑都要能跑,FP32/FP16兩組都要COPY進來。
COPY clip_vision.onnx clip_vision.onnx.data ./
COPY gpt.onnx gpt.onnx.data ./
COPY clip_vision.fp16.onnx clip_vision.fp16.onnx.data ./
COPY gpt.fp16.onnx gpt.fp16.onnx.data ./
COPY tokenizer.pkl .

WORKDIR /app/app
EXPOSE 7860

CMD ["python3", "app.py"]
